>"},{"location":"#_2","title":"\u0420\u043e\u0437\u0434\u0456\u043b\u0438","text":"\u0420\u043e\u0437\u0434\u0456\u043b \u041e\u043f\u0438\u0441 N5 \u041f\u043e\u0447\u0430\u0442\u043a\u043e\u0432\u0438\u0439 \u0440\u0456\u0432\u0435\u043d\u044c: \u0430\u0431\u0435\u0442\u043a\u0438, \u0431\u0430\u0437\u043e\u0432\u0430 \u0433\u0440\u0430\u043c\u0430\u0442\u0438\u043a\u0430, ~800 \u0441\u043b\u0456\u0432 N4 \u0415\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u0438\u0439 \u0440\u0456\u0432\u0435\u043d\u044c: \u0441\u043a\u043b\u0430\u0434\u043d\u0456\u0448\u0456 \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0456\u0457, ~1500 \u0441\u043b\u0456\u0432 \u0411\u0456\u0437\u043d\u0435\u0441 \u0442\u0430 \u0406\u0422 \u0421\u043f\u0435\u0446\u0456\u0430\u043b\u0456\u0437\u043e\u0432\u0430\u043d\u0430 \u043b\u0435\u043a\u0441\u0438\u043a\u0430, \u043a\u0435\u0439\u0433\u043e, \u0442\u0435\u0445\u043d\u0456\u0447\u043d\u0456 \u0442\u0435\u0440\u043c\u0456\u043d\u0438 \u0420\u0435\u0441\u0443\u0440\u0441\u0438 \u041a\u043e\u0440\u0438\u0441\u043d\u0456 \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f, \u0441\u043b\u043e\u0432\u043d\u0438\u043a\u0438, Anki \u043a\u043e\u043b\u043e\u0434\u0438"},{"location":"#_3","title":"\u041f\u0440\u043e \u0430\u0432\u0442\u043e\u0440\u043a\u0443","text":"<p>\u041f\u0440\u0438\u0432\u0456\u0442! \u042f \u0421\u0432\u0456\u0442\u043b\u0430\u043d\u0430 \u041f\u043e\u043b\u0456\u0449\u0443\u043a, \u0432\u0438\u0432\u0447\u0430\u044e \u044f\u043f\u043e\u043d\u0441\u044c\u043a\u0443 \u0442\u0430 \u0432\u0435\u0434\u0443 \u0446\u0435\u0439 \u043a\u043e\u043d\u0441\u043f\u0435\u043a\u0442 \u043f\u0443\u0431\u043b\u0456\u0447\u043d\u043e.</p> <ul> <li>LinkedIn</li> <li>GitHub</li> <li>Email</li> <li>Telegram</li> </ul>"},{"location":"#_4","title":"\u042f\u043a \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0442\u0438 \u043f\u0440\u043e\u0454\u043a\u0442\u0443","text":"<p>\u0417\u043d\u0430\u0439\u0448\u043b\u0438 \u043f\u043e\u